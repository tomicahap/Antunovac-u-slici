# ============================================================
# Google OAuth 2.0
# ============================================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Za lokalni razvoj:
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Za Render deployment (zamijenite s vašim URL-om):
# GOOGLE_REDIRECT_URI=https://your-app-name.onrender.com/api/auth/callback

# ============================================================
# Session sigurnost
# ============================================================
# Generirajte nasumičan niz od 32+ znaka
SESSION_SECRET=generirajte-tajni-kljuc-min-32-znaka-ovdje
# 32-bajtni hex ključ za AES-256 enkripciju (64 hex znaka)
# Generirajte: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# ============================================================
# Firebase konfiguracija (frontend - može biti javno)
# ============================================================
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# ============================================================
# Server
# ============================================================
PORT=3000
NODE_ENV=development
